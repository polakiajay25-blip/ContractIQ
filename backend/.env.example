# Reviewer account (single reviewer; replace both credentials before use)
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=replace-with-a-long-unique-password

# Use a cryptographically random value of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=60

# Leave DATABASE_URL unset for the local SQLite database.
# Production should use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/contract_reviews

# Optional local Redis cache; semantic retrieval still works without Redis.
# REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# The embedding model is downloaded once and runs locally.
POLICY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gemini API evidence review. Obtain a key from Google AI Studio.
# Gemini API usage has quotas; it may be billable depending on project setup.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Ollama alternative (local inference, no API usage charge).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Add the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
